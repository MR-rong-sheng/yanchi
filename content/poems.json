      "孤寂",
      "藏头"
    ]
  },
  {
    "id": "yongliu",
    "题": "咏柳",
    "作者": "贺知章",
    "朝代": "唐",
    "原文": [
      "碧玉妆成一树高，",
      "万条垂下绿丝绦。",
      "不知细叶谁裁出，",
      "二月春风似剪刀。"
    ],
    "注释": [
      {
        "词": "碧玉",
        "释": "青绿色的玉，这里比喻新柳的颜色。"
      },
      {
        "词": "妆",
        "释": "装扮，打扮。"
      },
      {
        "词": "绿丝绦",
        "释": "绿色的丝带，比喻下垂的柳条。绦：用丝线编成的带子。"
      },
      {
        "词": "裁",
        "释": "裁剪。"
      }
    ],
    "析": [
      "前两句只是漂亮：像玉、像丝带，把柳树写得几乎是一件首饰。",
      "后两句一问一答，才把诗写活。答话没有落在人身上，而落在了风上——原来春天是个手艺人。妙在用「剪刀」，这不是雅的东西，却是准的东西。"
    ],
    "标签": [
      "七言",
      "咏物",
      "比喻"
    ]
  },
  {
    "id": "tixilinbi",
    "题": "题西林壁",
    "作者": "苏轼",
    "朝代": "宋",
    "原文": [
      "横看成岭侧成峰，",
      "远近高低各不同。",
      "不识庐山真面目，",
      "只缘身在此山中。"
    ],
    "注释": [
      {
        "词": "题",
        "释": "书写，题写。题壁是宋人常事。"
      },
      {
        "词": "西林",
        "释": "西林寺，在庐山。"
      },
      {
        "词": "缘",
        "释": "因为。"
      }
    ],
    "析": [
      "前两句写「看不全」：横着看是岭，侧着看是峰，位置一变，山就变一样。",
      "后两句把这个经验说透了。它讲的不只是山，也讲人与人、事与事：身在其中的人，最难看清全局。这是宋诗特有的写法，先写景，再讲理。"
    ],
    "标签": [
      "七言",
      "哲理",
      "宋诗"
    ]
  },
  {
    "id": "guanshuyougan",
    "题": "观书有感",
    "作者": "朱熹",
    "朝代": "宋",
    "原文": [
      "半亩方塘一鉴开，",
      "天光云影共徘徊。",
      "问渠那得清如许？",
      "为有源头活水来。"
    ],
    "注释": [
      {
        "词": "方塘",
        "释": "方形的水塘。这里也常被理解为比喻书本、心智。"
      },
      {
        "词": "鉴",
        "释": "镜子。一鉴开：像打开一面镜子。"
      },
      {
        "词": "徘徊",
        "释": "来回移动。"
      },
      {
        "词": "渠",
        "释": "它，指方塘。"
      },
      {
        "词": "那",
        "释": "通「哪」，怎么。"
      },
      {
        "词": "源头活水",
        "释": "比喻不断来的新知识、新体验。"
      }
    ],
    "析": [
      "题名是「观书」，通篇却没有一句讲读书，全在写一塘水。这就是它的高明：把抽象的道理交给一个具体的池塘。",
      "最后一句是很多人抄在笔记本上的话。它说的其实是耐心——水清不是因为水好，是因为有东西一直在进来。"
    ],
    "标签": [
      "七言",
      "读书",
      "哲理"
    ]
  },
  {
    "id": "yueke",
    "题": "约客",
    "作者": "赵师秀",
    "朝代": "宋",
    "原文": [
      "黄梅时节家家雨，",
      "青草池塘处处蛙。",
      "有约不来过夜半，",
      "闲敲棋子落灯花。"
    ],
    "注释": [
      {
        "词": "黄梅时节",
        "释": "江南春末夏初的梅雨期。"
      },
      {
        "词": "家家雨",
        "释": "到处都在下雨。"
      },
      {
        "词": "灯花",
        "释": "灯芯烧后结成的花状物，落下说明夜已深。"
      }
    ],
    "析": [
      "前两句写声音：雨声一片，蛙声一片，越热闹越显得屋子空。",
      "后两句等的人没来。诗人没有抱怨，只是「闲敲棋子」。一个「闲」字其实并不闲——不然为什么敲？灯花落下，是等到了很晚的证据。"
    ],
    "标签": [
      "七言",
      "等待",
      "清幽"
    ]
  }

  {
    "id": "jingyesi",
    "题": "静夜思",
    "作者": "李白",
    "朝代": "唐",
    "原文": [
      "床前明月光，",
      "疑是地上霜。",
      "举头望明月，",
      "低头思故乡。"
    ],
    "注释": [
      {
        "词": "疑",
        "释": "以为，好像。不是「怀疑」。"
      },
      {
        "词": "举头",
        "释": "抬起头。"
      },
      {
        "词": "床",
        "释": "旧解有卧具、井栏、坐具几种说法，至今没有定论。读时不必执定一种。"
      }
    ],
    "析": [
      "前两句写错觉：月光太白太亮，一瞬之间被当成了地上的霜。写月光而先用「霜」，冷意、静意一起出来了。",
      "后两句是一组对称的动作，举头、低头，中间只隔了一个看月亮的瞬间，却把「思」字留在了最后。全诗二十字，没有一个生僻字，也没有一句议论。"
    ],
    "标签": [
      "五言",
      "思乡",
      "必背"
    ]
  },
  {
    "id": "dengquequanlou",
    "题": "登鹳雀楼",
    "作者": "王之涣",
    "朝代": "唐",
    "原文": [
      "白日依山尽，",
      "黄河入海流。",
      "欲穷千里目，",
      "更上一层楼。"
    ],
    "注释": [
      {
        "词": "白日",
        "释": "傍晚的太阳。"
      },
      {
        "词": "依",
        "释": "依傍，靠着。"
      },
      {
        "词": "穷",
        "释": "穷尽，看到尽头。"
      },
      {
        "词": "千里目",
        "释": "极远的视野。"
      },
      {
        "词": "更",
        "释": "再，又。"
      }
    ],
    "析": [
      "前两句是两种「尽」：太阳落到山后是「尽」，黄河奔流入海也是「尽」，画面一直在往极远处推。",
      "后两句忽然从景转到理，却不是生硬的道理——因为楼是真的可以再上一层。想看得更远，就得站得更高，这句话到今天还在被随口引用。"
    ],
    "标签": [
      "五言",
      "登临",
      "必背"
    ]
  },
  {
    "id": "chunxiao",
    "题": "春晓",
    "作者": "孟浩然",
    "朝代": "唐",
    "原文": [
      "春眠不觉晓，",
      "处处闻啼鸟。",
      "夜来风雨声，",
      "花落知多少。"
    ],
    "注释": [
      {
        "词": "不觉晓",
        "释": "不知不觉天就亮了。晓：天亮。"
      },
      {
        "词": "闻",
        "释": "听见。"
      },
      {
        "词": "啼鸟",
        "释": "鸟的叫声。"
      }
    ],
    "析": [
      "全诗是躺在床上写成的一首。眼睛没睁开，只听：鸟声、回想的风雨声，最后连「落花」也是猜的。",
      "妙处正在这份没看见。春天有多好，交给读者去想；一夜风雨摧折了多少，也交给读者去心疼。"
    ],
    "标签": [
      "五言",
      "春天",
      "必背"
    ]
  },
  {
    "id": "jiangxue",
    "题": "江雪",
    "作者": "柳宗元",
    "朝代": "唐",
    "原文": [
      "千山鸟飞绝，",
      "万径人踪灭。",
      "孤舟蓑笠翁，",
      "独钓寒江雪。"
    ],
    "注释": [
      {
        "词": "绝",
        "释": "尽，一只也没有。"
      },
      {
        "词": "万径",
        "释": "千万条小路。径：小路。"
      },
      {
        "词": "人踪",
        "释": "人的脚印。"
      },
      {
        "词": "蓑笠",
        "释": "蓑衣和斗笠，旧时雨雪天穿戴。"
      }
    ],
    "析": [
      "四句诗，前两句把天地清空：山无鸟，路无人。后两句才放进一个人——一叶舟，一个老翁，一根钓线。",
      "雪是钓不到的。他知道，读者也知道。这诗写的不是渔，是一个人被世界忘掉之后，仍然坐在那里。"
    ],
    "标签": [

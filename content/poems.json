  },
  {
    "id": "chounuer",
    "题": "丑奴儿·书博山道中壁",
    "作者": "辛弃疾",
    "朝代": "宋",
    "类": "词",
    "体裁": "词",
    "单元": "课外古诗词诵读（二）",
    "课": "课外古诗词诵读（二）",
    "原文": [
      "少年不识愁滋味，",
      "爱上层楼。",
      "爱上层楼，",
      "为赋新词强说愁。",
      "而今识尽愁滋味，",
      "欲说还休。",
      "欲说还休，",
      "却道“天凉好个秋”！"
    ],
    "注释": [
      {
        "词": "博山",
        "释": "地名，在今江西。"
      },
      {
        "词": "层楼",
        "释": "高楼。"
      },
      {
        "词": "强（qiǎng）说愁",
        "释": "勉强说愁。"
      },
      {
        "词": "识尽",
        "释": "尝遍，明白透了。"
      }
    ],
    "析": [
      "两片对得极清楚：少年时没有愁却要装愁，如今愁足了反而不说了。",
      "「却道天凉好个秋」是全词的闷——话到嘴边咽回去，只好谈天气。辛弃疾一辈子的不平之气，这里只用七个字。"
    ],
    "名句": [],

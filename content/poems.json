  {
    "id": "chouletian",
    "题": "酬乐天扬州初逢席上见赠",
    "作者": "刘禹锡",
    "朝代": "唐",
    "类": "诗",
    "体裁": "七言律诗",
    "单元": "第三单元",
    "课": "14 诗词三首",
    "原文": [
      "巴山楚水凄凉地，",
      "二十三年弃置身。",
      "怀旧空吟闻笛赋，",
      "到乡翻似烂柯人。",
      "沉舟侧畔千帆过，",
      "病树前头万木春。",
      "今日听君歌一曲，",
      "暂凭杯酒长精神。"
    ],
    "注释": [
      {
        "词": "弃置",
        "释": "被贬谪、被抛在一边。"
      },
      {
        "词": "闻笛赋",
        "释": "指向秀《思旧赋》，借指怀念亡友。"
      },
      {
        "词": "烂柯人",
        "释": "王质观棋烂柯的典故，指归来时人事全非。"
      },
      {
        "词": "长（zhǎng）精神",
        "释": "振作精神。"
      }
    ],
    "析": [
      "前四句全是旧账：贬所、二十三年的光阴、回来时已经不在的故人。五六句忽然换气——「沉舟侧畔千帆过，病树前头万木春」，他不是沉舟，也不是病树，他是从旁边经过的那个人。",
      "这两句常被当成乐观，其实更接近看透之后的通达：日子还在往前走，那就往前走。"
    ],

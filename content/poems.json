  {
    "id": "huanxisha",
    "题": "浣溪沙（漠漠轻寒上小楼）",
    "作者": "秦观",
    "朝代": "宋",
    "类": "词",
    "体裁": "词",
    "单元": "课外古诗词诵读（二）",
    "课": "课外古诗词诵读（二）",
    "原文": [
      "漠漠轻寒上小楼，",
      "晓阴无赖似穷秋。",
      "淡烟流水画屏幽。",
      "自在飞花轻似梦，",
      "无边丝雨细如愁。",
      "宝帘闲挂小银钩。"
    ],
    "注释": [
      {
        "词": "漠漠",
        "释": "弥漫的样子。"
      },
      {
        "词": "无赖",
        "释": "无端，没来由。"
      },
      {
        "词": "穷秋",
        "释": "晚秋。"
      },
      {
        "词": "淡烟",
        "释": "一作「澹烟」。两种印本都常见：「澹」是「淡」的异体写法，意思相同。"
      },
      {
        "词": "宝帘",
        "释": "缀有珍宝的帘子。"
      }
    ],
    "析": [
      "上片写外面的轻寒与屋里的画屏，都不浓，只是淡淡的。",
      "「自在飞花轻似梦，无边丝雨细如愁」把比喻反着用——不说梦像飞花，说飞花像梦；不说愁像丝雨，说丝雨像愁。这么一颠倒，抽象的东西反而成了本体，愁就有了形状。"
    ],
    "名句": [],
    "标签": [

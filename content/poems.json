  {
    "id": "shuidiaogetou",
    "题": "水调歌头（明月几时有）",
    "作者": "苏轼",
    "朝代": "宋",
    "类": "词",
    "体裁": "词",
    "单元": "第三单元",
    "课": "14 诗词三首",
    "原文": [
      "丙辰中秋，",
      "欢饮达旦，",
      "大醉，",
      "作此篇，",
      "兼怀子由。",
      "明月几时有？",
      "把酒问青天。",
      "不知天上宫阙，",
      "今夕是何年。",
      "我欲乘风归去，",
      "又恐琼楼玉宇，",
      "高处不胜寒。",
      "起舞弄清影，",
      "何似在人间。",
      "转朱阁，",
      "低绮户，",
      "照无眠。",
      "不应有恨，",
      "何事长向别时圆？",
      "人有悲欢离合，",
      "月有阴晴圆缺，",
      "此事古难全。",
      "但愿人长久，",
      "千里共婵娟。"
    ],
    "注释": [
      {
        "词": "子由",
        "释": "苏辙的字，苏轼的弟弟。"
      },
      {
        "词": "宫阙",
        "释": "宫殿。"
      },
      {
        "词": "不胜（shēng）",
        "释": "经受不住。"
      },
      {
        "词": "绮户",
        "释": "雕花的门窗。"
      },
      {
        "词": "婵娟",
        "释": "本指姿态美好，词中指月亮。"
      }
    ],
    "析": [
      "上半是「我欲乘风归去」的念头与「高处不胜寒」的迟疑；下半先抱怨月亮「何事长向别时圆」，随后自己把话劝回来。",
      "写的是中秋一个人在外的处境，结句却给天下所有分开的人用——所以它才流传得这么广。"
    ],
